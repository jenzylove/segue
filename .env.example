# Base mainnet
BASE_RPC_URL=
BASE_CHAIN_ID=8453

# Dedicated gas-only automation/deployer wallet
# Never commit the real key. EXECUTOR_ADDRESS must match EXECUTOR_PRIVATE_KEY.
EXECUTOR_PRIVATE_KEY=
EXECUTOR_ADDRESS=

# 1inch Business / Classic Swap API
# Keep server-side only. Create under a 1inch Business application.
ONEINCH_API_KEY=
# Fill from `python scripts/m2_preflight.py`; it must match 1inch /approve/spender.
EXECUTION_TARGET_ADDRESS=

# M2 verified public addresses
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_FEED_ADDRESS=0x7e860098F58bBFC8648a4311b374B1D669a2bc6B
# Default M2 stock: Coinbase NVIDIA tokenized stock (NVDAc)
B20_TOKEN_ADDRESS=0xb20000000000000000000078ee7ce2fE4908108C
B20_FEED_ADDRESS=0x04689a41629776563E6822F76f2e57D148d28513

# Filled only after the M2 deployment/user-vault transaction
ASSET_REGISTRY_ADDRESS=
FACTORY_ADDRESS=
DEMO_VAULT_ADDRESS=
M2_POLICY_ID=1
M2_BUY_USDC_ATOMIC=1000000
# Optional. Leave blank to sell the demo vault's actual B20 balance during B3.
M2_SELL_B20_ATOMIC=
M2_ONEINCH_SLIPPAGE_BPS=50

# Persistence
DATABASE_URL=

# Base attribution
BASE_BUILDER_CODE=

# Frontend public config
NEXT_PUBLIC_BASE_CHAIN_ID=8453
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_API_URL=

# Optional deployment/verification helpers
BASESCAN_API_KEY=
